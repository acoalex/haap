    {
      "id": "claim_48e372087559403da8edce08c4de3708",
      "statement": "HttpTransport failure semantics are explicit: HTTP 200 with a body returns the reply envelope; 202 means accepted-with-no-reply and returns None; only transient statuses (408, 429, 500, 502, 503, 504) are retried up to 3 times with backoff [0.5, 2.0, 5.0] under a 30-second timeout; validation 4xx errors and exhausted retries raise TransportError.",
      "evidence": [
