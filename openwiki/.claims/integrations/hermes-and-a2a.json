    {
      "id": "claim_c8af10f4b7944aa8b755e6c853e3188e",
      "statement": "The HTTP discovery surface of an agent is exactly three routes served live by the stdlib ThreadingHTTPServer layer: POST /haap/messages is the sole signed-envelope intake (200 with the reply envelope, 202 accepted when there is none, 400 on malformed envelope JSON); GET /.well-known/haap.json regenerates the public manifest on every request from the server's speciality/skills_dirs/extra_tools with no cached or on-disk copy; GET /health reports liveness; all other paths return 404.",
      "evidence": [
        {
          "resource": "repo://haap/server.py#L438-L457",
          "version": "repo-lines-v1:sha256:50c2a65d1f9328f66a8db57fcd6de650a813f4f0c9885506bdd67f3b9135822f:"
