  "claims": [
    {
      "id": "claim_6352a2e3177b4286b20512459505785a",
      "statement": "The Hermes integration surface of an agent is HAAPServer: its constructor accepts injectable callbacks on_task (executor: cb(task_id, payload) -> None | dict) and on_friend_request (owner notification: cb(fp, manifest) -> None), and the module documents this as the way to wire the server into Hermes — webhook to the owner chat for friend requests, task execution for delegated work. The callbacks are plain attributes that may also be assigned after construction (demo_marketplace assigns server.on_task after building the server).",
      "evidence": [
        {
          "resource": "repo://demo_marketplace.py#L32-L58",
          "version": "repo-lines-v1:sha256:553bfbdb550cc126371fbc1657c092098a33f15ba57d5d4c991d04f05881d4a1:"
        },
        {
          "resource": "repo://haap/server.py#L15-L16",
          "version": "repo-lines-v1:sha256:54914a01b9d0c2ec4dea0fb268d4e233a621f35e03e088c15e9c9d9086cd1d36:"
        },
