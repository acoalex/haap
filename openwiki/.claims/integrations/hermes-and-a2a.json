        }
      ]
    },
    {
      "id": "claim_a242981fa2fb43d2995c8669b4aae5b1",
      "statement": "Inbound friend_request is evaluated by RequestPolicy with three ordered outcomes: deny (blocklisted or default deny) answers an error envelope FRIEND_REQUEST_DENIED; auto-approve grants the matched role template capped by max_role and answers friend_accept carrying the exact granted matrix and granted_role; queue records the sender as pending_in, builds an actionable card via build_request, notifies the owner, and replies friend_request {received: true, pending_human: true, suggested_role}.",
      "evidence": [
        {
          "resource": "repo://haap/policy.py#L208-L223",
