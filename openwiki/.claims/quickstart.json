    {
      "id": "claim_f6fa8375f16946c18fe91981e4476511",
      "statement": "The HAAP messaging server (run via `haap serve`) exposes exactly three HTTP endpoints: POST /haap/messages as the entry point for signed envelopes, GET /.well-known/haap.json serving the public manifest without keys, and GET /health for liveness.",
