          "version": "repo-lines-v1:sha256:528d830e7a2eb07f0852490226d25208bcb5f898303c165684d3afab5020a34e:"
        }
      ]
    },
    {
      "id": "claim_cafdfca158024d5cbd66cfc352b74c40",
      "statement": "HAAP has two trust modes: alliance, in which two agents become friends through a verified challenge-response handshake that requires the receiving owner's human approval and grants a permission matrix; and marketplace, in which a business publishes open bookable services and any agent with a valid Ed25519 signature may use them without prior friendship, subject to audit, rate limits and instant blocking.",
      "evidence": [
        {
          "resource": "repo://README.md#L340-L343",
