      ]
    },
    {
      "id": "claim_cf0c6e0d20d845008d6c508c327751f9",
      "statement": "An agent's identity is an Ed25519 key pair persisted at $HAAP_DIR/identity.json (default ~/.haap) with mode 0600; the public identifier is the fingerprint 'HF-' plus the first 16 hex characters of SHA-256 of the raw public key, and the private key never leaves the machine (never in messages, manifests or audit records).",
      "evidence": [
        {
          "resource": "repo://docs/ARQUITECTURA.md#L74-L81",
          "version": "repo-lines-v1:sha256:fadcae1d4d531df8811490be078808655e6470ec2557dfe3d80d27ee5eddde5f:"
        },
        {
