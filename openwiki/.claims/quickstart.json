    {
      "id": "claim_52ef838cacb846479e85eddd3d66ec5b",
      "statement": "HAAP is an open, pure-Python agent protocol/library that requires Python >= 3.10, depends only on cryptography>=41.0 and requests>=2.28, uses no web framework (its HTTP surface is stdlib http.server), installs as the `haap` package, and exposes the `haap` console command whose entry point is haap.cli:main.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L5-L10",
          "version": "repo-lines-v1:sha256:a0856ed755b140e81625152f05d324efa3116450a72c4961fda612d7cb9bbd4f:"
        },
