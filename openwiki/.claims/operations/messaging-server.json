        }
      ]
    },
    {
      "id": "claim_5bfac33caf4d450297e7d9c0071e8725",
      "statement": "well_known_manifest() generates the document served at GET /.well-known/haap.json live on every request by calling capabilities.public_manifest with the local identity and the server's construction arguments speciality, skills_dirs and extra_tools — format haap-public-manifest-v1 with agent fingerprint/name/speciality/endpoint, public message types, scanned skills and tools, and never any key material; there is no on-disk copy being served and no caching.",
      "evidence": [
