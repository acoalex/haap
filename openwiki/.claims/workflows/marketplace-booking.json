  "claims": [
    {
      "id": "claim_cbe141e33cff4b42af816db1f479238f",
      "statement": "Marketplace mode is the no-friendship trust surface of HAAP: the service_search, service_quote, service_book and service_cancel message types are the only protocol messages a stranger may send, while everything else on the server stays deny-by-default — inbound task_request still requires an accepted friendship plus a granted task:submit permission, and unhandled message types are answered with a signed error envelope.",
      "evidence": [
        {
          "resource": "repo://haap/envelope.py#L45-L53",
          "version": "repo-lines-v1:sha256:65d5a2cdba20cbde11a7cb7f78c33dce472974180d8cebc99668b434a3a6692b:"
        },
        {
          "resource": "repo://haap/server.py#L283-L291",
          "version": "repo-lines-v1:sha256:24f8e162e20d6481555f45e6f4823798bf75981447224c57aa7939fb7f619393:"
        },
        {
          "resource": "repo://haap/server.py#L331-L335",
          "version": "repo-lines-v1:sha256:5a6d62d2096795d4c26ea3827e9d24d2a4172a7aca3055fa4d1164bd255b3666:"
        }
      ]
    },
    {
      "id": "claim_296561c207f64d6d8869e204d6a89355",
      "statement": "Because a marketplace sender may be a complete stranger, service_search/service_book/service_cancel/service_quote are bootstrap types: the router resolves the sender's public key from the payload's public_key_b64, enforces fingerprint == SHA-256(key) before use, and runs full envelope verification (Ed25519 signature, ±300 s clock window, nonce anti-replay) before any marketplace handler executes.",
      "evidence": [
        {
          "resource": "repo://haap/server.py#L106-L129",
          "version": "repo-lines-v1:sha256:c2339e000445b948a32457fe4789dd352c2a320fe04487e6facfee2c878f7518:"
        },
        {
          "resource": "repo://tests/test_marketplace.py#L36-L42",
          "version": "repo-lines-v1:sha256:a19533c22b297a2ccb8d6cee8816662d66dbeba16ac31aa2b727375368ef934d:"
        }
      ]
    },
    {
      "id": "claim_76257bdacfc9417c8dbecb32d2254a5e",
      "statement": "A business publishes open services purely through HAAPServer constructor arguments: marketplace_catalog (service -> info dict) and marketplace_policy; auto_accept defaults to False and is the only policy key the server enforces (a service_book without it is refused with PERMISSION_DENIED whose detail names auto_accept), while other keys such as open_hours are echoed in quotes but never enforced; the handlers answer even without configuration, so a bare server returns an empty-catalog service_quote with available false and can never book.",
      "evidence": [
        {
          "resource": "repo://haap/server.py#L352-L369",
          "version": "repo-lines-v1:sha256:55fb4651e7789e7b8a03313d26526cce75a60176c40f8d5fdcbcfae1cd904af8:"
        },
        {
