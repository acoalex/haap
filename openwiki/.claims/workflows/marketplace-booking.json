    {
      "id": "claim_b8a353bd179040f0aa8387f9d2eba4dd",
      "statement": "Quotes are one-way: a service_quote arriving at a business is verified as a bootstrap message and then answered with a signed error envelope ('service_quote not expected here'), and a booking is acknowledged with a task_result envelope, never a service_quote.",
