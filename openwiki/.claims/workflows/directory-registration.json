  "claims": [
    {
      "id": "claim_053fa83edce7464287c38e75a0e68c86",
      "statement": "The HAAP federated directory is a phone book, not a notary: identity lives in the agents' Ed25519 keys, and the registry's only jobs are to index signed manifests whose fingerprint matches the declared public key and to verify that the registering agent controls the endpoint it declares (proof-of-endpoint); it never decides who an agent is.",
      "evidence": [
        {
          "resource": "repo://haap/registry.py#L2-L19",
          "version": "repo-lines-v1:sha256:684ebd06afa57d3c8836f9106a5aca8ac0470230959653e0ff32250ed209dd4a:"
        }
      ]
    },
    {
      "id": "claim_10e2022aa28344cb953675942ec3a53e",
      "statement": "Registration is a two-round-trip HTTP flow: POST /register performs all verification first (fingerprint matches ^HF-[0-9a-f]{16}$, the submitted public key's fingerprint equals the declared fingerprint, the Ed25519 manifest signature verifies against that key, and the declared endpoint starts with http:// or https://) and only then issues a challenge; the agent is not listed at submit time.",
      "evidence": [
        {
          "resource": "repo://haap/registry.py#L60-L88",
          "version": "repo-lines-v1:sha256:f6b2880410c4801c23a6983ce31d2749220d857891ba7abba216e5c2f24ab164:"
        }
      ]
    },
    {
      "id": "claim_20bd2c042dd6425baa291819243f9626",
      "statement": "POST /register answers 200 with {challenge_nonce, registry_fingerprint, registry_signature}: the nonce is random 32-byte base64 and the signature is the directory's own Ed25519 signature over the nonce ASCII, letting the agent identify the directory it reached; the reference registry_client checks only for challenge_nonce and does not verify the registry signature.",
      "evidence": [
        {
          "resource": "repo://haap/registry.py#L221-L233",
          "version": "repo-lines-v1:sha256:ccdc70bc9e515f39c84cfafe57e9596572eab606636938a489fe2b17eaa1aa27:"
        },
        {
          "resource": "repo://haap/registry_client.py#L77-L81",
          "version": "repo-lines-v1:sha256:d2900ed263c725a76d7e40116ae8821a84c04e50ef9f7313a57bed47a61f9fb7:"
        }
      ]
    },
    {
      "id": "claim_849bb74e06d8497a8a18966d63782386",
      "statement": "The manifest itself never carries keys: the verified public key is remembered only inside the pending challenge record (fingerprint mapped to nonce, issue time and public_key_b64), and capabilities.public_manifest builds the published haap-public-manifest-v1 document from key-free identity projections, so the directory holds no key material it could leak or reuse.",
      "evidence": [
        {
          "resource": "repo://haap/capabilities.py#L113-L136",
          "version": "repo-lines-v1:sha256:5f48953782252374a0214e357781ce8c86e8b1bd233e55c7c2d41660bde46936:"
        },
        {
          "resource": "repo://haap/registry.py#L82-L88",
          "version": "repo-lines-v1:sha256:21bc2b6e46117f0f055ec3ba508ee59484d3c47ee8ec536b130a383084a35c28:"
        }
      ]
    },
    {
      "id": "claim_02ee351c0da5494989c013c7ae008562",
      "statement": "Completing registration is single-use and expiry-checked: complete_registration pops the pending challenge first so any completion attempt (failed or not) consumes it and forces a restart at POST /register, rejects challenges older than CHALLENGE_TTL_S (60 s), rejects a caller-supplied public key differing from the submit-verified key, and lists the agent only after the endpoint proof (the agent's Ed25519 signature over the nonce ASCII bytes) verifies against the submit-verified key.",
      "evidence": [
        {
          "resource": "repo://haap/registry.py#L35-L37",
          "version": "repo-lines-v1:sha256:2d2f822f91acc270861d13fe60c7ab97fd67aba2906f02ed25a1176f7fbb6c98:"
        },
        {
          "resource": "repo://haap/registry.py#L90-L127",
          "version": "repo-lines-v1:sha256:449798ecc17a4408898edee436fdfff84bdd68b5259f80d1eec08eb02129fea9:"
        }
      ]
    },
    {
      "id": "claim_9924f626d5754fdba857c6c3ac244132",
      "statement": "The core listing guarantee is that no agent is listed without a signed proof from the declared key: a proof signed by a different key is rejected and leaves the agent unlisted (test_failed_endpoint_proof_not_listed), and a fingerprint/key mismatch at submit is rejected before any challenge exists (test_registration_fingerprint_key_mismatch_rejected).",
      "evidence": [
        {
          "resource": "repo://haap/registry.py#L104-L108",
          "version": "repo-lines-v1:sha256:8e339f3592e9bffbbacb1c4f781984b02d376c8327670f9d4e8fb1722d5bdaf0:"
        },
        {
          "resource": "repo://tests/test_registry.py#L117-L151",
          "version": "repo-lines-v1:sha256:7fd8063fb38f8ef41d8f7d1edf2d71a62c93f207a2adf08c2cc2796d789a209b:"
        }
      ]
    },
    {
      "id": "claim_895e9487841245319f00ea65851eed4d",
      "statement": "A completed registration writes the record {manifest, registered_at, last_seen, endpoint_proof truncated to 64 chars, endpoint_nonce} keyed by fingerprint, and re-registering the same fingerprint overwrites it in place with fresh timestamps rather than duplicating it, so store.count() stays 1 (pinned by test_duplicate_registration_updates).",
      "evidence": [
        {
          "resource": "repo://haap/registry.py#L109-L117",
          "version": "repo-lines-v1:sha256:a9a8f2412575711c0e244b37bed0ba3266a1dcf29ed7ca4d26c3dc51e556284c:"
        },
        {
          "resource": "repo://tests/test_registry.py#L154-L170",
          "version": "repo-lines-v1:sha256:ac344a11f9839f96d1bb7b9d98258c5871b0cbc3444f6bf35b910fced2912cd1:"
        }
      ]
    },
    {
      "id": "claim_41f2fadbb7374d37b80ab8aadc7954ba",
      "statement": "Read paths expose only the manifest: /search returns {results: [manifest, ...]} and /agents/{fingerprint} returns the stored manifest (404 'not registered or expired' otherwise); stored endpoint proofs, nonces and timestamps never leak to clients.",
      "evidence": [
        {
          "resource": "repo://haap/registry.py#L145-L163",
          "version": "repo-lines-v1:sha256:389eb64057473bdd29cf587ce1b83c4d8db31a85e4ccaca2035fa1a046375194:"
        },
        {
          "resource": "repo://haap/registry.py#L195-L212",
          "version": "repo-lines-v1:sha256:17d80320e5b4b49a40f20a0d35d9f8ce09eb0f69e38fc5b6087c11fb438bbbb9:"
        }
      ]
    },
    {
      "id": "claim_b9a88e0cca4f43b8b92b560d2bc08264",
      "statement": "An entry is alive iff now - last_seen is at most the entry TTL (default ENTRY_TTL_S = 24 h); POST /heartbeat refreshes last_seen only for entries that are alive and answered 404 unknown otherwise, while expiry is lazy — get/search/count skip expired records but nothing physically removes them from the _agents dict. The reference heartbeat is unauthenticated: heartbeat() verifies no signature, so knowing a fingerprint is enough to renew its entry.",
      "evidence": [
        {
          "resource": "repo://haap/registry.py#L129-L167",
          "version": "repo-lines-v1:sha256:91d5a8b96546d639c15dec490d72beadc8b0e502d781d4ec7202221946e7baf5:"
        },
        {
          "resource": "repo://haap/registry.py#L56-L57",
          "version": "repo-lines-v1:sha256:66ae8cff2d859a06f055fe493a2df65a9a60fefaf205180854afbe604609197f:"
        },
        {
          "resource": "repo://tests/test_registry.py#L173-L189",
          "version": "repo-lines-v1:sha256:0d696c44d9ffbf3650feb05e58f827b119eaaa1c2a9f89660924bf5fc2d4ad88:"
        }
      ]
    },
    {
      "id": "claim_132d9c44ba4f4d33955bd5227a8739db",
      "statement": "MAX_AGENTS (10 000) is an anti-flooding cap checked only in submit_registration and only for fingerprints not already in the dict: a full directory rejects new fingerprints with 'directory full', while re-registration of any previously seen fingerprint always passes; because expired records are never pruned, the cap effectively counts every distinct fingerprint that ever completed registration in the process.",
      "evidence": [
        {
          "resource": "repo://haap/registry.py#L35-L37",
          "version": "repo-lines-v1:sha256:2d2f822f91acc270861d13fe60c7ab97fd67aba2906f02ed25a1176f7fbb6c98:"
        },
        {
          "resource": "repo://haap/registry.py#L84-L85",
          "version": "repo-lines-v1:sha256:b43eb00e563ddf90e526f48c26546c95c5c31235a7a41b570cb763f0111dc4c9:"
        }
      ]
    },
    {
      "id": "claim_5bac803ad765432e8b570071b408f806",
      "statement": "registry_client.build_registration returns (manifest, public_key_b64, manifest_signature) — a key-free public_manifest whose agent.endpoint is the declared messaging URL, plus the base64 public key and an Ed25519 signature over the manifest's canonical serialization — and registry_client.register() drives the whole flow (submit, sign the returned nonce, complete), returning the final response only when it says status registered and raising DiscoveryError on any rejection or unreachable directory.",
      "evidence": [
        {
          "resource": "repo://haap/capabilities.py#L113-L136",
          "version": "repo-lines-v1:sha256:5f48953782252374a0214e357781ce8c86e8b1bd233e55c7c2d41660bde46936:"
        },
        {
          "resource": "repo://haap/registry_client.py#L52-L89",
          "version": "repo-lines-v1:sha256:a76da6f5a63f0a6a91cf404c177542ee74b6b1530b35dcc1d275c93dcb756b7d:"
        }
      ]
    },
    {
      "id": "claim_76dce3705d364271a6a7dff570647f93",
      "statement": "The manifest signature and its server-side verification both use one canonical form — json.dumps(manifest, sort_keys=True, separators=(',', ':'), ensure_ascii=False) — so the signer and verifier recompute identical bytes, the same canonicalization used for envelope signing.",
      "evidence": [
        {
          "resource": "repo://haap/registry.py#L73-L77",
          "version": "repo-lines-v1:sha256:0e1ee3108f6e94e82a0d502709eb81b33a4aa5c3e41ff4b7b5620c3b9436ec10:"
        },
        {
          "resource": "repo://haap/registry_client.py#L60-L62",
          "version": "repo-lines-v1:sha256:8158e3712578c59c7f5a6b57467a7f86a2d57d730933c58f53e660b73e5454ce:"
        }
      ]
    },
    {
      "id": "claim_31b310f115cf44cda8d2b5eae0a6a734",
      "statement": "HeartbeatLoop keeps a registered agent's entry alive with a daemon thread that POSTs /heartbeat every interval_s (default DEFAULT_HEARTBEAT_S = 6 h, deliberately well below the 24 h entry TTL so an entry cannot lapse between beats), records the last outcome on last_ok with DiscoveryError counting as failure, and stop() ends the loop via a threading.Event.",
      "evidence": [
        {
          "resource": "repo://haap/registry_client.py#L105-L130",
          "version": "repo-lines-v1:sha256:6629642fb3c856681eb56fc398fe8b21466eff7f53eb78c364303fd42705b181:"
        },
        {
          "resource": "repo://haap/registry_client.py#L25-L25",
          "version": "repo-lines-v1:sha256:24249ad7d3a08ebeeb333fc500e4b2ba5219f142d7fec01eace25d769621d677:"
        }
      ]
    },
    {
      "id": "claim_25c10519cbcb4bb1913b8ca9a83cd011",
      "statement": "Search matches the capability parameter as a case-insensitive substring against agent.speciality plus every tools[] and skills[].name entry, and q as a case-insensitive substring over the whole manifest JSON; only alive entries are returned, as full public manifests.",
      "evidence": [
        {
          "resource": "repo://haap/registry.py#L145-L163",
          "version": "repo-lines-v1:sha256:389eb64057473bdd29cf587ce1b83c4d8db31a85e4ccaca2035fa1a046375194:"
        },
        {
          "resource": "repo://tests/test_registry.py#L192-L210",
          "version": "repo-lines-v1:sha256:79588745c3fb762f6d28697b58bba9fa9573322ba6ed4ef70cd33b663f9b8a07:"
        }
      ]
    },
    {
      "id": "claim_c0c4e4642b4048f2ad9de7da37914cca",
      "statement": "After discovery a client must re-verify the agent directly: HAAPClient.refresh_endpoint fetches the peer's /.well-known/haap.json from the recorded endpoint host and raises DiscoveryError ('possible endpoint substitution') when the manifest's agent.fingerprint differs from the recorded fingerprint, deriving and storing the fresh /haap/messages URL only on a match — which is why a compromised directory can hide or poison listings but cannot impersonate an agent, since the directory holds no keys and the well-known document is the agent's own live-generated, unsigned card.",
      "evidence": [
        {
          "resource": "repo://haap/client.py#L275-L296",
          "version": "repo-lines-v1:sha256:bae76e84a4fa01d394f91d4829f5ea16e6b454913f3da8ab38a77ec7adbe1d32:"
        },
        {
          "resource": "repo://haap/server.py#L97-L100",
          "version": "repo-lines-v1:sha256:b18b54b04f870433472fea76c87a6cca5f64f72a8b310f21a9f6466f863a8a17:"
        },
        {
          "resource": "repo://tests/test_client.py#L110-L134",
          "version": "repo-lines-v1:sha256:3332117067167dd5378888b14b19b9ea2e38bff75cc9a5b1431331dd1acf7a2f:"
        }
      ]
    }
  ],
