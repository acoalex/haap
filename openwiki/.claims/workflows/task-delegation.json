        },
        {
          "resource": "repo://haap/tasks.py#L162-L174",
          "version": "repo-lines-v1:sha256:df7006c796fe0db1002e0252638a69c7b347c182ee04c1a4cdbbba2681c2ecf0:"
        }
      ]
    },
    {
      "id": "claim_557146e4bba342d3b06ac8488231a346",
      "statement": "TaskRegistry is a local, per-agent store holding both halves of an agent's task activity in one file: HAAPClient writes delegated-task mirrors with role=\"delegate\" and HAAPServer writes received/executed tasks with role=\"server\" (the module docstring and the CLI help text say delegate/submit, a naming caveat that makes a haap task list --role submit filter match nothing in this revision); records carry task_id of the form T plus 16 hex uuid4 chars, prompt, the action/resource pair used for scope checks, state, a merged detail dict and a progress_log whose last 20 entries are serialized.",
      "evidence": [
        {
          "resource": "repo://haap/cli.py#L150-L166",
          "version": "repo-lines-v1:sha256:e1e5ca5ce3c9807fc17a9d892f0a2b2c9844754bb3cd315cfddf1b74c48ec5d7:"
