    {
      "id": "claim_349b399ac9434bfebb9d526de0417e59",
      "statement": "TaskRegistry persists a JSON list of records to tasks.json under its directory with atomic .tmp plus os.replace writes under a reentrant lock when constructed file-backed, and stays purely in memory when constructed with memory=True; both HAAPServer and HAAPClient default to TaskRegistry(memory=True), so stock wiring never writes tasks.json and embedders that want durable task history must construct TaskRegistry(directory) and inject it into the server and/or client.",
      "evidence": [
        {
          "resource": "repo://haap/client.py#L65-L81",
