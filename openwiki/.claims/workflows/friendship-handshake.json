          "version": "repo-lines-v1:sha256:e9ab379c97391d9eace5051d2de0f5cdb3f4a1624960a99630f1647ad1878e8e:"
        }
      ]
    },
    {
      "id": "claim_e68de478b79f4c5984ca096872255927",
      "statement": "Handshake failure semantics are pinned by tests against the real router: a tampered signature answers BAD_SIGNATURE, a replayed envelope answers NONCE_REPLAY, an out-of-window timestamp answers CLOCK_SKEW, a non-bootstrap message from an unknown sender answers BAD_SIGNATURE, and an impostor envelope signed under A's identity but declaring a foreign public key is rejected with BAD_SIGNATURE because fingerprint != SHA-256(declared key) — so the bootstrap channel cannot be used to hijack a fingerprint.",
      "evidence": [
        {
          "resource": "repo://tests/test_server.py#L156-L210",
          "version": "repo-lines-v1:sha256:e31612f56a9a342bb1f4a21c2840a7cc3629bea1d3da2ff0ec0400b628dae9c4:"
        },
        {
          "resource": "repo://tests/test_server.py#L43-L88",
          "version": "repo-lines-v1:sha256:98c06fe60e499b58163e6b2605f5d0457b56cc21d807a8deea4ca0f4f74450d5:"
        }
      ]
    },
    {
      "id": "claim_5a64d20508594e92944233d407e27abc",
      "statement": "policy.py defines PENDING_TTL_DAYS = 7 for expiry of undecided friend requests, but in this revision no code path enforces it: a queued request stays pending_in indefinitely until a human decides, which operators of a long-running server should account for.",
      "evidence": [
        {
          "resource": "repo://haap/policy.py#L49-L49",
          "version": "repo-lines-v1:sha256:c454a47457fd23c6e420bddaa93215647bb847af1a914027241268d6814d8fc7:"
        }
