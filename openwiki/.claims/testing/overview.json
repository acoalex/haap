    {
      "id": "claim_d372c3f780674fadb2913c2b184816b4",
      "statement": "Two wiring styles dominate the suite: server-side tests sign envelopes with env_mod.sign_body and call server.handle_message directly, while end-to-end client tests couple HAAPClient A to HAAPServer B by assigning client_a.transport = MemoryTransport(lambda env, url: server_b.handle_message(env)) — MemoryTransport.send just invokes its deliver function and returns the reply dict, giving the same router semantics the HTTP layer uses.",
      "evidence": [
        {
          "resource": "repo://haap/server.py#L131-L160",
          "version": "repo-lines-v1:sha256:be05e4fb1055120deb04e264eb10134991bab4d0811e5df615593421f76d7633:"
