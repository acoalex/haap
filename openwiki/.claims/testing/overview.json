    {
      "id": "claim_555fff3b516b40d09f77edaf7289d14d",
      "statement": "tests/test_server.py pins the full friendship handshake through the router: hello answered with a hello_ack challenge, challenge signed by the sender's private key answered with verify, a formal friend_request leaving the sender pending_in in the receiver's directory, human directory.approve with a concrete grant, friend_accept, and accepted status on both sides.",
      "evidence": [
        {
          "resource": "repo://tests/test_server.py#L43-L87",
          "version": "repo-lines-v1:sha256:dee8f14dd866bfcff842159c731fe5a3f18a45130dd995537ce1338814a7e7be:"
        }
