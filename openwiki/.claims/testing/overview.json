    {
      "id": "claim_8794f279e14e4b54a80b274411b295ae",
      "statement": "tests/test_server.py pins the task authorization matrix against the router with assertable error codes: an approved friend granted task:submit with booking:* scope gets a synchronous task_result with state completed whose detail comes from the injected on_task callback; an unknown friend yields FRIEND_NOT_FOUND, an explicit allow:False grant yields PERMISSION_DENIED, and a capacity-1 rate limit makes the following request RATE_LIMITED.",
      "evidence": [
        {
          "resource": "repo://tests/test_server.py#L90-L153",
          "version": "repo-lines-v1:sha256:e4b616c5776be8d2993435c76f944a223d09df5f4942af442bbdf41320add5e6:"
        }
      ]
    },
    {
      "id": "claim_1af571b41803461b8845fe908b597e8b",
      "statement": "tests/test_server.py pins envelope security rejections at the router boundary as signed error envelopes: a tampered signature yields BAD_SIGNATURE, replaying the identical envelope yields NONCE_REPLAY, a timestamp 4000 seconds in the past yields CLOCK_SKEW, a non-bootstrap ping from an unknown sender yields BAD_SIGNATURE (no key to verify against), and a bootstrap hello whose declared public key does not hash to the claimed fingerprint yields BAD_SIGNATURE.",
      "evidence": [
        {
          "resource": "repo://tests/test_server.py#L156-L210",
          "version": "repo-lines-v1:sha256:e31612f56a9a342bb1f4a21c2840a7cc3629bea1d3da2ff0ec0400b628dae9c4:"
