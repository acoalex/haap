          "version": "repo-lines-v1:sha256:9f224ea57a1502acfd5821ea6d399268c50e531a5a5e03688be72828efc0b5e1:"
        }
      ]
    },
    {
      "id": "claim_1b37a24595874a1889d69dd9cf0e441d",
      "statement": "Audit entries are redacted before writing (threat T7): _safe() replaces the value of any top-level detail key in _SENSITIVE_KEYS — challenge_token, private_key, signature, task_payload — with '<redacted>', so key material, handshake challenges, and task payloads never land in the log and the file stays safe to share.",
      "evidence": [
        {
          "resource": "repo://haap/audit.py#L23-L33",
          "version": "repo-lines-v1:sha256:c52f3b365644be57cd620b04351b6d034ead0aff3292e51590507943c994e36e:"
        },
