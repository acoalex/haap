    {
      "id": "claim_aeb16e4ab68248a08649e23b4bc6f369",
      "statement": "The router's try/except structure in server.handle_message guarantees every handled inbound message is audited: verification failures are logged as message.rejected with result 'error' and the exception class plus a 120-character excerpt, handler failures as message.<type> with result 'error', successes as message.<type> with result 'ok'; friendship decisions emit friend_request.denied_by_policy (result 'deny' with reason), friend_request.auto_approved (role), and friend_request.queued; marketplace handlers emit marketplace.search/book/cancel; the client emits client.friend_request.sent, client.task.completed, client.marketplace.booked and client.<type>.error; and PermissionMatrix.grant/revoke emit permission.grant/permission.revoke.",
      "evidence": [
