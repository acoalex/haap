        }
      ]
    },
    {
      "id": "claim_fc2001bfdecf422f82393519780dbeb6",
      "statement": "A rate-limit rejection is transparent on the wire: RateLimitedError (errors.py) has code RATE_LIMITED, transient=True, and a retry_after of max(1, int(wait)+1) seconds derived from the emptier of the action and global buckets; the server converts it into a signed error envelope carrying error_code, detail truncated to 200 chars, and in_reply_to_nonce, and clients translate received codes back into a transient local exception via ERROR_MAP/error_from_code.",
      "evidence": [
        {
          "resource": "repo://haap/client.py#L111-L117",
          "version": "repo-lines-v1:sha256:3a6cc8f7b1cbb24ead7734dd5ce3e25af5c2ff2f25e8e22e416917d739c1d146:"
        },
