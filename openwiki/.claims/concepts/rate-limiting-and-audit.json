    {
      "id": "claim_e17bfcda51564d7faa0edf3841f4dcb5",
      "statement": "AuditLog writes an append-only JSON-lines trail to <HAAP_DIR>/audit.log ($HAAP_DIR or ~/.haap): each event() call builds {ts rounded to 3 decimals, event, friend, action, result defaulting to 'ok', detail} and appends one line under a single per-instance lock, opening the file in append mode per event so entries are never modified or removed in place.",
      "evidence": [
        {
          "resource": "repo://haap/audit.py#L19-L21",
          "version": "repo-lines-v1:sha256:ca0ce45e70ce584f960ea8b936f77703e14fe8caa1ed9b9b757d1cb2e90f5f5a:"
        },
