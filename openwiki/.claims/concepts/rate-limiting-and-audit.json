        }
      ]
    },
    {
      "id": "claim_21537f12169147ab813b1d3177ed68a8",
      "statement": "In file mode the audit log rotates by size: when audit.log reaches MAX_FILE_BYTES (5 MB) it is shifted to audit.log.1, the previous .1 to .2, and anything older than KEEP_ROTATED (2 backups) is dropped; rotation failures are swallowed (OSError) so logging never breaks the protocol.",
      "evidence": [
        {
          "resource": "repo://haap/audit.py#L69-L83",
          "version": "repo-lines-v1:sha256:8fda269be1edf06f493a8fc514193960402a36684ce657917b9e7e322154fd9b:"
