          "version": "repo-lines-v1:sha256:52ecee093ba7312ac145dd839ea9d5fd91c4db724f05d4bf13cb10197bf1f814:"
        }
      ]
    },
    {
      "id": "claim_188f9cdd8f0b4a9bbf0c2fe4dcbe07a0",
      "statement": "resolve_role(name, directory) re-reads roles.json on every call — so roles.json edits take effect at the next approval without restarting — returning (name, spec) and raising ValueError listing the known roles for an unknown name; role_summary() renders the one-line-per-role listing behind the CLI command listing available roles.",
