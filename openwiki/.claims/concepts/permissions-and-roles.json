    },
    {
      "id": "claim_d158820f91a244a9b5f65886f5baad6d",
      "statement": "load_roles() deep-copies the built-ins and then applies $HAAP_DIR/roles.json: a user role may name an extends base (a built-in or an earlier user role in file order) whose spec is shallow-merged at the top level with the user's keys minus extends, so whole dictionaries such as permissions or rate_limits are replaced wholesale rather than merged action-by-action; unknown extends names resolve to an empty base, invalid entries are skipped, and missing, unreadable, non-dict or JSON-corrupt roles.json returns the built-ins so a bad roles file never breaks an approval.",
      "evidence": [
        {
          "resource": "repo://haap/roles.py#L94-L121",
          "version": "repo-lines-v1:sha256:2c1d512d4a06d95b88ee2eb442044d74b9d9b962f3ad5d4a47f8cf6b7986fe1d:"
        },
        {
