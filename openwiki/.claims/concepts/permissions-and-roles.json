    },
    {
      "id": "claim_54d6eecf3f7d4fdcbcc974bf88673399",
      "statement": "The friend-request policy engine caps every auto-approval on the ladder guest < client < partner < family < admin via max_role (default partner): a rule naming admin is downgraded when the cap is lower, an explicitly requested role is likewise reduced to the cap, and any unknown or custom role auto-approves capped at client; human approvals through the CLI approve path are not capped because queueing exists precisely for a human override.",
      "evidence": [
        {
          "resource": "repo://haap/cli.py#L105-L118",
          "version": "repo-lines-v1:sha256:6045528f9672a1bb0bdf8a8eebc35e36dd6f995169e9a5b4100afa5790d1823f:"
