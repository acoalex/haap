    {
      "id": "claim_d5245abc08354a3d9e15aecfc155b4e2",
      "statement": "Messages are size-capped for anti-flooding: MAX_PAYLOAD_BYTES = 1,000,000 and envelope_from_bytes rejects any message whose UTF-8 length exceeds MAX_PAYLOAD_BYTES + 4096 bytes (1 MB payload plus 4 KB envelope overhead) with MalformedEnvelopeError before JSON parsing.",
