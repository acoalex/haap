    {
      "id": "claim_6eaa550d3b4349129d92c6eaf8c8c821",
      "statement": "Every rejection after envelope parsing is a signed error envelope produced by server._error_reply: addressed back to the original sender with payload {error_code, detail (truncated to 200 chars), in_reply_to_nonce echoing the rejected envelope's nonce}, so the sender can attribute each failure to its own envelope and third parties cannot forge rejections.",
      "evidence": [
