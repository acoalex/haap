    {
      "id": "claim_755bc26beb3a4ade96993240afd01f8c",
      "statement": "Discovery clients re-verify agents directly: HAAPClient.refresh_endpoint fetches the friend's /.well-known/haap.json (base URL derived by stripping /haap/messages from the recorded endpoint), raises DiscoveryError ('possible endpoint substitution') when the manifest's agent.fingerprint differs from the recorded one, and on match prepends the manifest's agent.endpoint plus /haap/messages to FriendRecord.endpoints when it is new; tests pin both the rejection and the acceptance path.",
      "evidence": [
        {
          "resource": "repo://haap/client.py#L276-L296",
          "version": "repo-lines-v1:sha256:1b1a3c9bbd4ee2c12ff5d963b6f68292e7e5ea0c587fca8fe9b72fe28f9ca770:"
