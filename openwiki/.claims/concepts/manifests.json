        }
      ]
    },
    {
      "id": "claim_af6af1b2bcd442af994301b3992efb3e",
      "statement": "Hermes skill introspection: the skills arrays of both manifest formats come from scan_installed_skills, which scans the SKILLS_CANDIDATES directories (~/.hermes/skills and ~/.hermes/profiles/default/skills, overridable via the skills_dirs argument) and, for each immediate subdirectory containing SKILL.md, contributes {name, description} read conservatively from the file's YAML frontmatter by regex (only name and description keys, no YAML parser dependency), deduplicated by first-seen skill directory name; an unreadable or missing frontmatter degrades to the directory name and empty description rather than failing.",
      "evidence": [
        {
          "resource": "repo://haap/capabilities.py#L29-L33",
          "version": "repo-lines-v1:sha256:8ba8215b25e7ba649c34b6b6e6d817e8864f4a91825dc5d5074731ccae135848:"
        },
