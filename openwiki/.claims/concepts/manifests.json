    {
      "id": "claim_745312540df44f0c967b73206966a30d",
      "statement": "During the friendship handshake only a capability summary travels: HAAPClient.start_friendship builds the full local manifest with build_manifest but sends just {speciality, format} inside the friend_request payload's capabilities field; the receiving HAAPServer stores it as FriendRecord.declared_capabilities, which feeds the owner notification card and RequestPolicy auto-approve/deny rule matching on speciality, and surfaces in the CLI's pending-request listing.",
      "evidence": [
        {
          "resource": "repo://haap/client.py#L126-L162",
          "version": "repo-lines-v1:sha256:ab7b35113f17af2d7a23bbc6d22dbdbd4232bdf5fcae15712cea5818aa4e9120:"
