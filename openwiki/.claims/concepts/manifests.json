  "claims": [
    {
      "id": "claim_d0826f91f6f544fcb09ab1060dd2d710",
      "statement": "haap/capabilities.py is the single manifest authority and defines two deliberately different key-free JSON documents: the owner-facing full manifest built by build_manifest (format haap-capability-manifest-v1, carrying agent public claims, haap_version, speciality, MESSAGE_TYPES_PUBLIC, scanned skills, sorted tools and generated_at) and the discovery-facing public manifest built by public_manifest (format haap-public-manifest-v1, with protocol_version and a flat agent block of fingerprint, name, speciality and a single endpoint URL). Both are key-free by construction because they are derived from Identity.public_claims(), the only identity projection that excludes key material.",
      "evidence": [
        {
          "resource": "repo://haap/capabilities.py#L1-L13",
          "version": "repo-lines-v1:sha256:eb621eb33344811d79251af4e4f777223cb374ca604e4ca6c1e8153aeb6fa64a:"
        },
        {
          "resource": "repo://haap/capabilities.py#L92-L136",
          "version": "repo-lines-v1:sha256:e2cbbb9acac9a99b663436d1fa90b570599767523368ee9d46c61bade69b1229:"
        },
        {
