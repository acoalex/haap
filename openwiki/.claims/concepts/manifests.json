          "version": "repo-lines-v1:sha256:f04a3c64fb978d6b5f350a23b519789c1c82c2b30d7b54382791da4509fdebeb:"
        }
      ]
    },
    {
      "id": "claim_94ca76897090473280118f2a7f74915f",
      "statement": "The well-known HTTP contract: HAAPServer exposes GET /.well-known/haap.json (alongside POST /haap/messages and GET /health), and each request is answered 200 application/json with a public manifest regenerated live by HAAPServer.well_known_manifest() calling public_manifest with the server's identity, speciality, skills_dirs and extra_tools; any other GET path returns 404. The design mirrors the A2A Agent Card at /.well-known/agent-card.json.",
      "evidence": [
        {
          "resource": "repo://docs/ARQUITECTURA.md#L277-L282",
          "version": "repo-lines-v1:sha256:f586f3fbb445a443c3e8e041d51be86994425324b2dad20fb192e7e2a8d6a9ae:"
