        }
      ]
    },
    {
      "id": "claim_e74488570180474fb91d1b2bfbb2fe3d",
      "statement": "Inbound friend_requests are decided by the policy engine with exactly three outcomes in order — deny (policy default deny or deny rule), auto (only when an explicit allowlist rule matches an exact fingerprint or declared speciality), queue (default) — where queue stores the request as pending_in and notifies the human owner; auto-approvals never exceed the configured max_role (default partner on the ladder guest less than client less than partner less than family less than admin) and unknown custom roles auto-approve capped at client.",
      "evidence": [
        {
          "resource": "repo://haap/policy.py#L56-L128",
          "version": "repo-lines-v1:sha256:d187b5220851558bc26f307a1200a857ab53f4fef3bd153a507bbbcac2b03063:"
        },
        {
          "resource": "repo://haap/roles.py#L30-L91",
