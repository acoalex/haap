    {
      "id": "claim_e973d8a1dcdc459891922e17a7caa19d",
      "statement": "The audit trail is append-only JSON lines at <HAAP_DIR>/audit.log with 5 MB size rotation keeping two rotated files and an in-memory mode for tests; the router's try/except structure in handle_message guarantees both accepted messages and rejected ones (verification failures logged as message.rejected) leave a trace, and _safe redacts detail values under the keys challenge_token, private_key, signature, and task_payload before anything is written.",
      "evidence": [
