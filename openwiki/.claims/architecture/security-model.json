    },
    {
      "id": "claim_6ead055817d146378396f59958356c29",
      "statement": "Marketplace open-services mode (service_search, service_quote, service_book, service_cancel) requires signed envelopes and prior friendship only as an exception to the bootstrap self-contained key verification: blocked fingerprints are rejected with PERMISSION_DENIED, a dedicated stricter rate limit applies (marketplace bucket capacity 10 refill 0.05 per second), and service_book is denied unless the business policy sets auto_accept true; everything else stays deny-by-default.",
      "evidence": [
        {
          "resource": "repo://haap/envelope.py#L45-L53",
          "version": "repo-lines-v1:sha256:65d5a2cdba20cbde11a7cb7f78c33dce472974180d8cebc99668b434a3a6692b:"
