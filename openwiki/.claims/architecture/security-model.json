    {
      "id": "claim_29d57fd9c4084c1c9121c4425bfd2ef0",
      "statement": "HAAP-emitted manifests never contain key material: public_manifest publishes only fingerprint, name, speciality, endpoint, message types, skills, and tools, and capabilities.parse_manifest rejects inbound manifests carrying private_key, public_key, or signature fields as defense in depth.",
