  "claims": [
    {
      "id": "claim_908e841881fc4b57a57212304e47c8be",
      "statement": "An agent's identity is its Ed25519 keypair: the public fingerprint is 'HF-' plus the first 16 hex characters of the SHA-256 digest of the raw public key, and it is only a short human/directory handle — cryptographic matching always uses the full public key.",
      "evidence": [
        {
          "resource": "repo://haap/identity.py#L37-L39",
          "version": "repo-lines-v1:sha256:219745769ede06b1c07f75177e8fff7f20a3ffc8584dd71adbc850255595c4f5:"
        },
        {
          "resource": "repo://haap/identity.py#L4-L12",
          "version": "repo-lines-v1:sha256:cce522d97ac1949fde6e4f52abe9eece959a8479ba1022032dd9b96982da30bb:"
        }
      ]
    },
    {
      "id": "claim_d520d1f9e2b848dea79157e37515fff3",
      "statement": "The Ed25519 private key never leaves the machine: it is persisted only at <HAAP_DIR>/identity.json written atomically via temp file plus os.replace and chmod'ed to mode 0600, and it never appears in messages, public manifests, or audit entries; compromise of identity.json is therefore treated as full key compromise.",
      "evidence": [
        {
          "resource": "repo://haap/crypto.py#L9-L11",
          "version": "repo-lines-v1:sha256:a42ee81bb6ea51b19099547d45f09d773462bc3381e5d6df9dbc5582cf1efdbf:"
        },
        {
          "resource": "repo://haap/identity.py#L139-L146",
          "version": "repo-lines-v1:sha256:780d8fb36e497c7efab0914b06760c3d724c7dbed220be1c9eb85a2ea21e4f55:"
        }
      ]
    },
    {
      "id": "claim_8c0bb9dd33fe4a31926fa49f0bf30c01",
      "statement": "Signed data must use deterministic canonical JSON: canonical_json() recursively sorts dict keys, uses compact separators and UTF-8 without unnecessary escapes, allows only native JSON types, and raises MalformedEnvelopeError for floats (representation ambiguity across platforms); the payload walk _check_payload_jsonable enforces the same float ban and rejects non-string keys recursively.",
      "evidence": [
        {
          "resource": "repo://haap/envelope.py#L61-L116",
          "version": "repo-lines-v1:sha256:a1b87e047a07b52dc1ed8fe834c2c0b1df85a97885480604280731c5545ae3f3:"
        }
      ]
    },
    {
      "id": "claim_dd082d60a56c44c1a4aa4535146c2a59",
      "statement": "An envelope signature covers the canonical JSON of every field except 'signature' (signing_payload), binding protocol_version, message_type, sender and recipient fingerprints, timestamp, nonce, and payload together so fields cannot be substituted after capture.",
      "evidence": [
        {
          "resource": "repo://haap/envelope.py#L119-L145",
          "version": "repo-lines-v1:sha256:fb419f5fb00bc3c55c7c15744e47fdb07d07b0a20c7f49c866d3853511a8407a:"
        }
      ]
    },
    {
      "id": "claim_9ddb9f8459af4e71a8deb95794c901ee",
      "statement": "Envelope parsing enforces structural bounds before any cryptographic work: an allowlisted MESSAGE_TYPES set, exact protocol_version match, and a maximum envelope size of MAX_PAYLOAD_BYTES (1 MB) plus 4 KB overhead, so unknown types and oversized bodies never reach a handler.",
      "evidence": [
        {
          "resource": "repo://haap/envelope.py#L153-L187",
          "version": "repo-lines-v1:sha256:47abbf5c4f4bf5bfc10f940a7554fbc4faa3b415185e8adb1f38687a3f77c4b8:"
        },
        {
          "resource": "repo://haap/envelope.py#L45-L58",
          "version": "repo-lines-v1:sha256:0efd2575d1ae716d555afcc4728c3265e63cd91b56ed4a26b8ff8423a551c17e:"
        }
      ]
    },
    {
      "id": "claim_3ca43ff56a8545c7b3fc290786ae6c88",
      "statement": "Anti-replay is mandatory and clock-independent: check_timestamp rejects messages outside now plus or minus MAX_CLOCK_SKEW (300 s), and NonceManager remembers (sender_fingerprint, nonce) pairs for a TTL of 660 s with lazy pruning and a 100,000-entry cap, so a replayed message fails with NONCE_REPLAY inside the window or CLOCK_SKEW once it ages out of the window.",
      "evidence": [
        {
          "resource": "repo://haap/envelope.py#L190-L237",
          "version": "repo-lines-v1:sha256:340b1530cc4215b4f2edd5642aeb12a5a84eb6ef1f76728471ab538db125211c:"
        },
        {
          "resource": "repo://haap/envelope.py#L240-L271",
          "version": "repo-lines-v1:sha256:1543197e523fc7d85a2c4a30d0eb19acc251b40b00be0bdb27071c3823a3fd7a:"
        }
      ]
    },
    {
      "id": "claim_4d11f2d4904b4a16b9b5476b9dbd016e",
      "statement": "Every inbound message passes one router (HAAPServer.handle_message): structural parse, sender key resolution, ±300 s timestamp window, Ed25519 verification against the fingerprint-bound public key, then nonce anti-replay before dispatch; bootstrap message types (hello, challenge, friend_request, service_*) carry the sender's public key in the payload and the router validates fingerprint equals SHA-256 of that key, and senders with no usable key are rejected on the wire as BAD_SIGNATURE.",
      "evidence": [
        {
          "resource": "repo://haap/envelope.py#L240-L271",
          "version": "repo-lines-v1:sha256:1543197e523fc7d85a2c4a30d0eb19acc251b40b00be0bdb27071c3823a3fd7a:"
        },
        {
          "resource": "repo://haap/server.py#L106-L167",
          "version": "repo-lines-v1:sha256:1a7dcdfb444dcbcbed7854ac421acdc77d82eb4ef59d94c3c9732fde492555ef:"
        }
      ]
    },
    {
      "id": "claim_04a64dc807994f9289373acd7e2d6f86",
      "statement": "Alliance-mode friendship bootstrap proves private-key possession before any relationship exists: hello is answered with a signed random challenge (server-held, 120 s expiry), the requester must sign the challenge text with its private key, and only then is the sender registered as a known entity without changing any existing relationship status.",
      "evidence": [
        {
          "resource": "repo://haap/directory.py#L194-L220",
          "version": "repo-lines-v1:sha256:9a8071e7cdab83286ac14858500abad2fa0064e924b24f1791b5e09de74d615b:"
