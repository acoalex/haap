    {
      "id": "claim_71236a65713640b2b4da5c0cfeed6e08",
      "statement": "The federated directory is a phone book not a notary: registration requires a manifest whose signature verifies against a public key whose SHA-256 fingerprint matches the claimed identity, the validated key is kept in the registry's challenge state (so manifests need not and must not carry keys), and an agent is listed only after signing the registry nonce with that key within 60 s; entries expire after 24 h without a heartbeat (default renewal every 6 h), the directory caps at 10,000 agents, and re-registration updates rather than duplicates.",
      "evidence": [
        {
          "resource": "repo://haap/registry.py#L35-L127",
          "version": "repo-lines-v1:sha256:33bbb1ce5565aac9cc098c9e7114bf339237af240c54b016fec2b80f8b623d83:"
        },
        {
          "resource": "repo://haap/registry_client.py#L25-L26",
          "version": "repo-lines-v1:sha256:54812e777916615195dd5d74cf747b0f6f7503e2daff7d7fc85d071253fb7dca:"
        }
      ]
    },
    {
      "id": "claim_8ba2503a1f254f68a8a8c222fe49c7f7",
      "statement": "Directory compromise is bounded because identity lives in keys: client.refresh_endpoint fetches the agent's own /.well-known/haap.json and raises DiscoveryError when the manifest fingerprint does not match the recorded friend, so a poisoned directory can hide or misroute search results but cannot substitute an endpoint without detection.",
      "evidence": [
        {
          "resource": "repo://haap/client.py#L276-L296",
          "version": "repo-lines-v1:sha256:1b1a3c9bbd4ee2c12ff5d963b6f68292e7e5ea0c587fca8fe9b72fe28f9ca770:"
        }
