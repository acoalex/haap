    },
    {
      "id": "claim_44f64a1a44a24593964c1f6e4612b3d1",
      "statement": "Friendship state is owned by Directory: human approve() transitions pending_in to accepted and stamps the permission matrix the owner grants (a role template or the DEFAULT_GRANT_TEMPLATE that grants chat:converse plus task:delegate and task:submit with no file or exec scopes), deny() removes the entry, and block() sets status blocked and empties the matrix as an absolute deny state; roles bundle matrices plus rate limits and guest has no task delegation.",
      "evidence": [
        {
          "resource": "repo://haap/directory.py#L273-L310",
          "version": "repo-lines-v1:sha256:c4142b50194d19b11fc77a7d88291c7f9f67c63bdd3dba100dff5dbef4af1b5c:"
